<experiment>
    <fileAuthor>P. Wang and T. Nagy</fileAuthor>
    <fileVersion>
        <major>1</major>
        <minor>0</minor>
    </fileVersion>
    <ReSpecThVersion>
        <major>2</major>
        <minor>5</minor>
    </ReSpecThVersion>
    <bibliographyLink>
        <description>John Bugler, Brandon Marks, Olivier Mathieu, Rachel Archuleta, Alejandro Camou, Claire Grégoire, Karl A. Heufer, Eric L. Petersen, Henry J. Curran: An ignition delay time and chemical kinetic modeling study of the pentane isomers</description>
        <referenceDOI>10.1016/j.combustflame.2015.09.014</referenceDOI>
        <details>
            <author>John Bugler, Brandon Marks, Olivier Mathieu, Rachel Archuleta, Alejandro Camou, Claire Grégoire, Karl A. Heufer, Eric L. Petersen, Henry J. Curran</author>
            <journal>Combust. Flame</journal>
            <pages>138-156</pages>
            <title>An ignition delay time and chemical kinetic modeling study of the pentane isomers</title>
            <volume>163</volume>
            <year>2016</year>
        </details>
    </bibliographyLink>
    <experimentType>ignition delay measurement</experimentType>
    <apparatus>
        <kind>shock tube</kind>
        <mode>reflected shock</mode>
    </apparatus>
    <commonProperties>
        <property name="equivalence ratio"    label="equivalence ratio"           sourcetype="reported"  units="unitless"      ><value>0.3</value></property>
        <property name="initial composition"  sourcetype="reported" >
            <component><speciesLink preferredKey="IC5H12"  CAS="78-78-4"    InChI="1S/C5H12/c1-4-5(2)3/h5H,4H2,1-3H3"  SMILES="CCC(C)C"  chemName="isopentane" /><amount units="mole fraction" >0.007813468</amount></component>
            <component><speciesLink preferredKey="O2"      CAS="7782-44-7"  InChI="1S/O2/c1-2"                         SMILES="O=O"      chemName="oxygen"     /><amount units="mole fraction" >0.208359172</amount></component>
            <component><speciesLink preferredKey="N2"      CAS="7727-37-9"  InChI="1S/N2/c1-2"                         SMILES="N#N"      chemName="nitrogen"   /><amount units="mole fraction" >0.783827360</amount></component>
        </property>
        <property name="evaluated standard deviation"  sourcetype="estimated"  units="unitless"       reference="ignition delay"  kind="relative"  method="generic uncertainty" ><value>0.1</value></property>
    </commonProperties>
    <dataGroup id="dg1">
        <property name="pressure"        id="p"    label="p"    sourcetype="reported"  units="atm" />
        <property name="temperature"     id="T"    label="T"    sourcetype="reported"  units="K"   />
        <property name="ignition delay"  id="tau"  label="tau"  sourcetype="reported"  units="us"  />

        <dataPoint><p>10.50</p><T>1135.00</T><tau>1223.00</tau></dataPoint>
    </dataGroup>
    <ignitionType target="p;" type="d/dt max"/>
</experiment>
